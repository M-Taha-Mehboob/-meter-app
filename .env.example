# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API (or the "Connect" button).
# .env.local is gitignored. Never commit real keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The public client key: "anon" key (legacy, starts with eyJ...) or "publishable" key (sb_publishable_...).
# NEVER put the service_role / secret key here: anything starting with VITE_ ends up in the browser.
VITE_SUPABASE_ANON_KEY=
